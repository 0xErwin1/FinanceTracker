{
  "extends": "../../tsconfig.base.json",
  "files": ["src/server.ts"],
  "include": ["src/**/*.ts"],
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "typeRoots": ["node_modules/@types"],
    "baseUrl": "src",
    "paths": {
      "config/*": ["config/*"],
      "enums/*": ["enums/*"],
      "helpers/*": ["helpers/*"],
      "lib/*": ["lib/*"],
      "models/*": ["models/*"],
      "services/*": ["services/*"],
      "trpc/*": ["trpc/*"],
      "types/*": ["types/*"],
      "utils/*": ["utils/*"],
      "src/*": ["*"],
      "*": ["../node_modules/@types/*", "types/*"]
    }
  },
  "exclude": ["node_modules"]
}
