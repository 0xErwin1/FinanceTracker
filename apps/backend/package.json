{
  "name": "@expenses/backend",
  "version": "0.2.0",
  "main": "dist/server.js",
  "types": "dist/trpc/root.d.ts",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/trpc/root.d.ts"
    }
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "rm -rf dist/ && tsc",
    "dev": "nodemon",
    "start": "NODE_PATH=dist/ node dist/server.js",
    "test": "env $(cat .env.test | grep -v '#' | xargs) ENV=test jest --verbose --colors --coverage --detectOpenHandles --forceExit --runInBand",
    "lint": "pnpm biome check {src/,test/}/**/*.ts",
    "format": "pnpm biome format --write {src/,test/}**/*.ts"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.2",
    "@types/jest": "^29.5.14",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.11.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "ts-jest": "^29.3.2",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@expenses/api": "workspace:*",
    "@trpc/server": "^11",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.74.1",
    "connect-redis": "^7.1.1",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "ioredis": "^5.10.1",
    "morgan": "^1.10.0",
    "pg": "^8.16.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "redis": "^4.7.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.22",
    "typeorm-naming-strategies": "^4.1.0",
    "uuid": "^11.1.0",
    "zod": "^3"
  }
}
