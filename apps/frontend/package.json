    "apexcharts": "^5.10.6",
    "lucide-vue-next": "^1.0.0",
    "tailwindcss": "^4.2.2",
    "vue": "^3.5",
    "vue-router": "^4.6.4",
    "vue3-apexcharts": "^1.11.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5",
    "typescript": "^5.8",
    "vite": "^6",
    "vitest": "^2.1.9",
    "vue-tsc": "^2"
  }
