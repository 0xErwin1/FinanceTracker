#!/usr/bin/env bash

BIOME="node_modules/.bin/biome check"
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMTR | grep -E '(.ts)$')
PASS=true

if [[ "$STAGED_FILES" == "" ]]; then
  exit 0
fi

for FILE in $STAGED_FILES
do
  $BIOME "$FILE"

  if [[ "$?" == 0 ]]; then
    echo -e "\e[34;1m==>\e[0m \e[32;1m[Biome Passed]:\e[0m $FILE"
  else
    echo -e "\e[34;1m=>\e[0m \e[31;1m[Biome Failed]:\e[0m $FILE"
    PASS=false
  fi
done

if ! "$PASS"; then
  echo -e "\n\e[34;1m=> \e[31;1m[COMMIT FAILED]:\e[0m Biome failed on staged files. Please check your code and try again. You can run Biome manually via 'pnpm lint'. \n"
  exit 1
else
  echo -e "\e[34;1m==> \e[32;1mCOMMIT SUCCEEDED\e[0m\n"
fi

exit "$?"
